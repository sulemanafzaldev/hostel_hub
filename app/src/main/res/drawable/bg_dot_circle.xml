<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <solid android:color="@android:color/transparent" />

    <!-- Dashed Stroke -->
    <stroke
        android:width="2dp"
        android:color="#4359D0"
        android:dashWidth="10dp"
        android:dashGap="6dp" />

    <!-- Size of the circle -->
    <size
        android:width="100dp"
        android:height="100dp" />
</shape>
