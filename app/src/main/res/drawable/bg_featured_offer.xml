<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base Gradient -->
    <item>
        <shape>
            <gradient
                android:startColor="#22C55E"
                android:endColor="#1E3A8A"
                android:angle="0"/>
        </shape>
    </item>

    <!-- Dark Right Overlay Shape -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E3A8A"/>
        </shape>
        <inset
            android:left="120dp"/>
    </item>

</layer-list>