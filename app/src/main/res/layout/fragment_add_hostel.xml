<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="20dp"
    tools:context=".ui.admin.auth.fragment.AddHostelFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Hostel Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hostel name"
            android:textSize="@dimen/_12ssp"
            android:textColor="@color/black"
            android:fontFamily="@font/sen_bold" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etHostelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_edittext"
            android:hint="GreenLeaf Hostel"
            android:padding="@dimen/_8sdp" />

        <!-- Location -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Location"
            android:textColor="@color/black"
            android:fontFamily="@font/sen_bold" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/etLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="@dimen/_8sdp"
            android:background="@drawable/bg_edittext"
            android:hint="City, Area"
            android:paddingHorizontal="@dimen/_12sdp" />

        <!-- Image Upload Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Cover image"
            android:textColor="@color/black"
            android:fontFamily="@font/sen_bold"/>

        <LinearLayout
            android:id="@+id/btnUploadImage"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/dashed_border_bg"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_upload" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drag &amp; drop or click to upload"
                android:textColor="@color/black"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PNG, JPG up to 5MB"
                android:textSize="@dimen/_7ssp" />
        </LinearLayout>

        <!-- Facilities RecyclerView -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Facilities"
            android:textColor="@color/black"
            android:fontFamily="@font/sen_bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFacilities"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:orientation="horizontal"
            tools:listitem="@layout/item_facility_chip" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:backgroundTint="@color/white"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="@color/black"
                app:icon="@drawable/ic_back"
                app:iconTint="@color/black" />

            <Button
                android:id="@+id/btnAddHostel"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:backgroundTint="#5E5CE6"
                android:text="Add Hostel"
                android:textAllCaps="false"
                android:textColor="@color/white" />
        </LinearLayout>


        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/str_already_have_an_account_sign_in"
            android:layout_margin="@dimen/_32sdp"
            android:gravity="center"
            android:textSize="@dimen/_11ssp"
            android:id="@+id/tvSignIn"
            />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>